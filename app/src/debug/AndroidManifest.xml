<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application android:networkSecurityConfig="@xml/debug_network_security">
        <activity android:name=".game.ui.integration.IntegrationEntryActivity" android:exported="true" android:label="@string/game_integration_title" android:theme="@style/Theme.FirstStep.GamePreview" />
        <activity
            android:name=".game.ui.home.GameHomeActivity"
            android:exported="true"
            android:label="@string/game_home_title"
            android:theme="@style/Theme.FirstStep.GamePreview" />
        <receiver
            android:name=".game.notifications.IntroQuizReminderReceiver"
            android:exported="false" />
        <activity
            android:name=".game.ui.intro.IntroQuizActivity"
            android:exported="true"
            android:label="@string/game_intro_title"
            android:theme="@style/Theme.FirstStep.GamePreview" />
        <activity
            android:name=".game.ui.discovery.DiscoveryActivity"
            android:exported="true"
            android:label="@string/game_discovery_title"
            android:theme="@style/Theme.FirstStep.GamePreview" />
        <activity
            android:name=".game.ui.preview.GamePreviewActivity"
            android:exported="true"
            android:label="@string/game_preview_title"
            android:theme="@style/Theme.FirstStep.GamePreview" />
    </application>
</manifest>
