<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_identity_host" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/game_reskin_artwork" android:scaleType="centerCrop"
        android:contentDescription="@null" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/game_welcome_scrim" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/game_identity_shell" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ScrollView android:id="@+id/game_identity_welcome" android:layout_width="match_parent"
                android:layout_height="match_parent" android:fillViewport="true">
                <LinearLayout android:id="@+id/game_identity_welcome_scroll" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:gravity="bottom"
                    android:padding="24dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/game_main_brand" android:textSize="18sp" android:textColor="#FFFFFF" />
                    <TextView android:id="@+id/game_identity_welcome_title" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/game_main_heading"
                        android:textSize="42sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:accessibilityHeading="true" android:layout_marginBottom="28dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="18dp" android:background="@drawable/game_welcome_panel">
                        <Button android:id="@+id/game_identity_welcome_guest" style="@style/GameActionButton"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_main_start" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/game_identity_welcome_login"
                            style="@style/GameIdentityGoogleButton" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/game_identity_login" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/game_main_optional" android:textColor="@color/game_color_text"
                            android:textSize="14sp" android:layout_marginTop="8dp" />
                        <TextView android:id="@+id/game_main_welcome_status" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/game_color_text"
                            android:accessibilityLiveRegion="polite" android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <include layout="@layout/game_main_dashboard" />
            <ScrollView android:id="@+id/game_identity_root" android:layout_width="match_parent"
                android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="18dp" android:background="@drawable/game_welcome_panel">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/game_main_my" android:textSize="26sp" android:textStyle="bold"
                            android:textColor="@color/game_color_text" android:accessibilityHeading="true" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/game_main_profile_optional" android:textColor="@color/game_color_text"
                            android:textSize="16sp" android:layout_marginTop="8dp" />
                        <TextView android:id="@+id/game_identity_status" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/game_color_text"
                            android:accessibilityLiveRegion="polite" android:layout_marginVertical="8dp" />
                        <LinearLayout android:id="@+id/game_identity_form" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <EditText android:id="@+id/game_identity_name" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:minHeight="48dp" android:singleLine="true"
                                android:inputType="textPersonName" android:hint="@string/game_identity_name"
                                android:saveEnabled="false" android:importantForAutofill="no" />
                            <EditText android:id="@+id/game_identity_student" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:minHeight="48dp" android:singleLine="true"
                                android:inputType="textNoSuggestions" android:hint="@string/game_identity_student"
                                android:saveEnabled="false" android:importantForAutofill="no" />
                            <AutoCompleteTextView android:id="@+id/game_identity_college" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:minHeight="48dp" android:singleLine="true"
                                android:inputType="text" android:completionThreshold="0" android:hint="@string/game_main_college"
                                android:saveEnabled="false" android:importantForAutofill="no" />
                            <AutoCompleteTextView android:id="@+id/game_identity_department" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:minHeight="48dp" android:singleLine="true"
                                android:inputType="text" android:completionThreshold="0" android:hint="@string/game_identity_department"
                                android:saveEnabled="false" android:importantForAutofill="no" />
                        </LinearLayout>
                        <Button android:id="@+id/game_identity_begin_edit" style="@style/GameSecondaryButton"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_main_edit" />
                        <Button android:id="@+id/game_identity_save" style="@style/GameActionButton"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_main_save" />
                        <TextView android:id="@+id/game_main_local_status" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:accessibilityLiveRegion="polite" />
                        <TextView android:id="@+id/game_main_profile_scope" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:layout_marginTop="8dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/game_main_local_note" android:textColor="@color/game_color_text" android:textSize="14sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/game_identity_login"
                            style="@style/GameIdentityGoogleButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/game_identity_login" />
                        <Button android:id="@+id/game_identity_retry" style="@style/GameSecondaryButton"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_identity_retry" />
                        <Button android:id="@+id/game_identity_reselect" style="@style/GameSecondaryButton"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_identity_reselect" />
                        <Button android:id="@+id/game_identity_logout" style="@style/GameSecondaryButton"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_identity_logout" />
                        <TextView android:id="@+id/game_identity_environment" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
        <include layout="@layout/game_main_navigation" />
    </LinearLayout>
</FrameLayout>
