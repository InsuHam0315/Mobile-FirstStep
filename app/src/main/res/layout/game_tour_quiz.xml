<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_tour_quiz"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/game_tour_quiz_back" style="@style/GameNarrationTextButton"
            android:layout_width="48dp" android:layout_height="48dp" android:padding="0dp"
            android:text="@string/game_guide_back_arrow" android:textSize="24sp"
            android:contentDescription="@string/game_software_demo_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/game_tour_quiz_title" android:textColor="@color/game_color_text"
            android:textSize="24sp" android:textStyle="bold" android:accessibilityHeading="true" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/game_discovery_step_idle" android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" android:text="@string/game_discovery_demo_mode"
            android:textColor="@color/game_color_text" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/game_tour_quiz_tabs"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal" />
    <TextView android:id="@+id/game_tour_quiz_page" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:layout_marginStart="5dp"
        android:background="@drawable/game_booklet_tab" android:paddingHorizontal="17dp" android:paddingVertical="6dp"
        android:textColor="@color/game_color_on_action" android:textStyle="bold" android:textSize="16sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/game_reskin_card" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/game_tour_quiz_prompt"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:drawablePadding="10dp"
            android:textSize="20sp" android:textStyle="bold" android:textColor="@color/game_color_text"
            android:accessibilityHeading="true" android:accessibilityLiveRegion="polite" />
        <RadioGroup android:id="@+id/game_tour_quiz_options"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="vertical" android:saveEnabled="false" />
        <View android:id="@+id/game_tour_quiz_source_divider"
            android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="10dp" android:background="@color/game_reskin_line" />
        <Button android:id="@+id/game_tour_quiz_source" style="@style/GameNarrationTextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/game_color_action" android:text="@string/game_guide_review_source" />
    </LinearLayout>
    <TextView android:id="@+id/game_tour_quiz_note"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="13dp" android:layout_marginBottom="8dp" android:gravity="center"
        android:textColor="@color/game_color_text" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/game_tour_quiz_previous" style="@style/GameSecondaryButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:text="@string/game_guide_previous" />
        <Button android:id="@+id/game_tour_quiz_next" style="@style/GameActionButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/game_tour_quiz_next" />
    </LinearLayout>
    <Button android:id="@+id/game_tour_quiz_home" style="@style/GameNarrationTextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/game_software_demo_back" />
</LinearLayout>
