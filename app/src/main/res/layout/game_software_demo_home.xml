<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/game_home_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/game_color_surface" android:orientation="vertical" android:padding="@dimen/game_space_medium">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <Button android:id="@id/game_home_back" style="@style/GameNarrationTextButton"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="0dp"
                android:text="@string/game_guide_back_arrow" android:textSize="24sp"
                android:contentDescription="@string/game_narration_back" />
            <TextView android:id="@+id/game_software_demo_home_title" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/game_demo_hub_title" android:accessibilityHeading="true"
                android:textStyle="bold" android:textColor="@color/game_color_text" android:textSize="26sp" />
            <TextView android:id="@id/game_home_context" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/game_discovery_step_idle" android:paddingHorizontal="12dp" android:paddingVertical="6dp"
                android:text="@string/game_discovery_demo_mode" android:textColor="@color/game_color_text" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@id/game_home_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" android:text="@string/game_integration_loading" android:textColor="@color/game_color_text" />
        <Button android:id="@id/game_home_retry" style="@style/GameActionButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/game_home_retry" android:visibility="gone" />
        <LinearLayout android:id="@id/game_home_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="130dp"
                android:layout_marginTop="12dp" android:background="@drawable/game_reskin_tinted_card"
                android:padding="20dp" android:gravity="center_vertical">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no" android:src="@drawable/game_discovery_arrival_pin" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_demo_hub_building" android:textColor="@color/game_color_text" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_demo_hub_department" android:textColor="@color/game_color_text" android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:orientation="vertical" android:background="@drawable/game_reskin_card" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_demo_hub_sequence" android:textColor="@color/game_color_text" android:textSize="20sp" android:textStyle="bold" android:accessibilityHeading="true" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView android:id="@+id/game_demo_step_discovery" android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_weight="1" android:gravity="center" android:minHeight="42dp"
    android:background="@drawable/game_discovery_step_idle" android:drawableStart="@drawable/game_demo_hub_search_icon"
    android:drawablePadding="3dp" android:paddingHorizontal="7dp" android:textSize="14sp"
    android:textStyle="bold" android:textColor="@color/game_color_text" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="4dp"
    android:text="@string/game_discovery_step_arrow" android:textColor="@color/game_color_text" android:importantForAccessibility="no" /><TextView android:id="@+id/game_demo_step_intro" android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_weight="1.35" android:gravity="center" android:minHeight="42dp"
    android:background="@drawable/game_discovery_step_idle" android:drawableStart="@drawable/game_guide_icon_book"
    android:drawablePadding="3dp" android:paddingHorizontal="7dp" android:textSize="14sp"
    android:textStyle="bold" android:textColor="@color/game_color_text" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="4dp"
    android:text="@string/game_discovery_step_arrow" android:textColor="@color/game_color_text" android:importantForAccessibility="no" /><TextView android:id="@+id/game_demo_step_quiz" android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_weight="1" android:gravity="center" android:minHeight="42dp"
    android:background="@drawable/game_discovery_step_idle" android:drawableStart="@drawable/game_booklet_checklist_icon"
    android:drawablePadding="3dp" android:paddingHorizontal="7dp" android:textSize="14sp"
    android:textStyle="bold" android:textColor="@color/game_color_text" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/game_demo_hub_complete_card" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/game_reskin_card" android:padding="14dp"
                android:gravity="center_vertical" android:visibility="gone">
                <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="10dp" android:padding="8dp"
                    android:background="@drawable/game_discovery_step_idle" android:src="@drawable/game_demo_hub_check_icon" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/game_demo_hub_complete_title" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textStyle="bold" android:textSize="19sp" android:textColor="@color/game_color_text" />
                    <TextView android:id="@+id/game_demo_hub_complete_body" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/game_color_text" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:background="@drawable/game_reskin_card" android:padding="14dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:drawableStart="@drawable/game_demo_hub_stamp_icon" android:drawablePadding="10dp"
                    android:text="@string/game_demo_hub_stamp_label" android:textColor="@color/game_color_text" android:textStyle="bold" android:textSize="18sp" />
                <TextView android:id="@id/game_home_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/game_color_text" android:textStyle="bold" android:textSize="18sp" />
            </LinearLayout>
            <TextView android:id="@id/game_integration_home_context" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp" android:drawablePadding="7dp"
                android:drawableStart="@drawable/game_demo_hub_info_icon" android:textColor="@color/game_color_text" android:textSize="14sp" />
            <TextView android:id="@+id/game_demo_hub_message" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="5dp" android:visibility="gone"
                android:accessibilityLiveRegion="polite" android:textColor="@color/game_reskin_muted" android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton android:id="@id/game_home_prototype" style="@style/GameActionButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="@string/game_demo_hub_start" android:enabled="false" app:icon="@drawable/game_demo_hub_arrow_icon"
                app:iconGravity="textEnd" app:iconTint="@color/game_reskin_primary_text" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
