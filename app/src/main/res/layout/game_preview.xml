<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/game_space_large">
        <TextView
            android:id="@+id/game_preview_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/game_preview_heading"
            android:textColor="@color/game_color_text"
            android:textSize="@dimen/game_text_title"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/game_space_medium"
            android:text="@string/game_preview_notice"
            android:textColor="@color/game_color_text"
            android:textSize="@dimen/game_text_body" />
        <TextView
            android:id="@+id/game_preview_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/game_space_large"
            android:accessibilityLiveRegion="polite"
            android:text="@string/game_preview_loading"
            android:textColor="@color/game_color_text"
            android:textSize="@dimen/game_text_body" />
        <Button
            style="@style/GameActionButton"
            android:id="@+id/game_preview_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/game_space_medium"
            android:minHeight="@dimen/game_touch_min"
            android:backgroundTint="@color/game_color_action"
            android:textColor="@color/game_color_on_action"
            android:text="@string/game_preview_item"
            android:visibility="gone" />
        <Button
            style="@style/GameActionButton"
            android:id="@+id/game_preview_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/game_touch_min"
            android:text="@string/game_preview_retry"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
