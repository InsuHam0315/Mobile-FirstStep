<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/game_reskin_control_space"
    android:background="@drawable/game_reskin_card"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/game_space_medium">
    <Button
        android:id="@+id/game_guide_section_toggle"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/game_reskin_control_space"
        android:gravity="start|center_vertical"
        android:minHeight="@dimen/game_touch_min"
        android:paddingHorizontal="0dp"
        android:textColor="@color/game_color_text"
        android:textSize="@dimen/game_text_body"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/game_guide_section_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/game_reskin_control_space"
        android:visibility="gone" />
</LinearLayout>
