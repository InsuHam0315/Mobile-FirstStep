<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_discovery_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/game_space_medium" android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <Button android:id="@+id/game_discovery_back" style="@style/GameNarrationTextButton"
            android:layout_width="@dimen/game_touch_min" android:layout_height="@dimen/game_touch_min"
            android:padding="0dp" android:text="@string/game_guide_back_arrow" android:textSize="24sp"
            android:contentDescription="@string/game_narration_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:accessibilityHeading="true" android:text="@string/game_discovery_title" android:textColor="@color/game_color_text"
            android:textSize="24sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:layout_marginBottom="16dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:drawableStart="@drawable/game_guide_icon_visit" android:drawablePadding="6dp"
            android:text="@string/game_discovery_demo_place" android:textSize="14sp" android:textColor="@color/game_color_text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/game_discovery_step_idle" android:paddingHorizontal="10dp" android:paddingVertical="4dp"
            android:text="@string/game_discovery_demo_mode" android:textColor="@color/game_color_text" />
    </LinearLayout>
    <LinearLayout android:id="@+id/game_discovery_steps" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:layout_marginBottom="16dp">
        <TextView android:id="@+id/game_discovery_step_arrival" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="36dp" android:gravity="center" android:textStyle="bold" android:textColor="@color/game_color_text" android:text="@string/game_discovery_step_arrival" android:background="@drawable/game_discovery_step_idle" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="5dp" android:text="@string/game_discovery_step_arrow" android:textColor="@color/game_color_text" android:importantForAccessibility="no" /><TextView android:id="@+id/game_discovery_step_align" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="36dp" android:gravity="center" android:textStyle="bold" android:textColor="@color/game_color_text" android:text="@string/game_discovery_step_align" android:background="@drawable/game_discovery_step_idle" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="5dp" android:text="@string/game_discovery_step_arrow" android:textColor="@color/game_color_text" android:importantForAccessibility="no" /><TextView android:id="@+id/game_discovery_step_find" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="36dp" android:gravity="center" android:textStyle="bold" android:textColor="@color/game_color_text" android:text="@string/game_discovery_step_find" android:background="@drawable/game_discovery_step_idle" />
    </LinearLayout>
    <LinearLayout android:id="@+id/game_discovery_stage_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/game_reskin_card" android:padding="12dp">

        <TextView android:id="@+id/game_discovery_arrival_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:text="@string/game_discovery_demo_arrival_title" android:gravity="center" android:textSize="16sp" android:drawableTop="@drawable/game_discovery_arrival_pin" android:drawablePadding="6dp" android:textStyle="bold" android:paddingBottom="12dp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/game_discovery_preview_height"
        android:background="@drawable/game_reskin_tinted_card" android:clipToOutline="true">
    <androidx.camera.view.PreviewView android:id="@+id/game_discovery_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0" />
    <ImageView android:id="@+id/game_discovery_art" android:layout_width="208dp" android:layout_height="208dp"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="4dp"
        android:src="@drawable/game_narration_kangrin" android:contentDescription="@string/game_narration_kangrin_art" />
    <TextView android:id="@+id/game_discovery_camera_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="10dp" android:paddingHorizontal="14dp" android:paddingVertical="5dp"
        android:background="@drawable/game_reskin_card" android:textColor="@color/game_color_text" android:textStyle="bold" android:visibility="gone" />
</FrameLayout>
        <TextView android:id="@+id/game_integration_discovery_context" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:text="@string/game_discovery_demo_local" android:gravity="center" android:textSize="16sp" android:paddingTop="10dp" />
    
</LinearLayout>
    <TextView android:id="@+id/game_discovery_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:gravity="center" android:textSize="16sp" android:paddingTop="12dp" android:textStyle="bold" android:visibility="gone" />
    <TextView android:id="@+id/game_discovery_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:gravity="center" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:id="@+id/game_discovery_shake_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="12dp" android:visibility="gone">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:text="@string/game_discovery_demo_shake_title" android:gravity="center" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/game_discovery_shake_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:id="@+id/game_discovery_shake_segments" android:layout_width="match_parent"
            android:layout_height="6dp" android:layout_marginHorizontal="28dp" android:layout_marginTop="8dp"
            android:importantForAccessibility="no">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"  android:background="@drawable/game_discovery_step_idle" />
<View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/game_discovery_step_idle" />
<View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/game_discovery_step_idle" />
<View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/game_discovery_step_idle" />
<View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/game_discovery_step_idle" />
        </LinearLayout>
    
</LinearLayout>
    <Button android:id="@+id/game_discovery_arrival" style="@style/GameActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_discovery_arrival" android:enabled="false" android:layout_marginTop="12dp" />
    <Button android:id="@+id/game_discovery_align_fallback" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_discovery_align_fallback" android:visibility="gone" />
    <Button android:id="@+id/game_discovery_camera_fallback" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_discovery_camera_fallback" android:visibility="gone" />
    <LinearLayout android:id="@+id/game_discovery_method_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:layout_marginVertical="8dp" android:background="@drawable/game_reskin_card" android:visibility="gone">

        <Button android:id="@+id/game_discovery_method_toggle" style="@style/GameNarrationTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_discovery_demo_methods" android:drawableStart="@drawable/game_discovery_method_icon" android:drawableEnd="@drawable/game_guide_icon_down" android:drawablePadding="8dp" android:gravity="start|center_vertical" />
        <LinearLayout android:id="@+id/game_discovery_method_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">

            <Button android:id="@+id/game_discovery_method_shake" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_discovery_shake"  />
            <Button android:id="@+id/game_discovery_method_light" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_discovery_light" android:visibility="gone" />
            <TextView android:id="@+id/game_discovery_disclosure" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:text="@string/game_discovery_demo_disclosure" android:paddingBottom="8dp" android:textSize="14sp" />
        
</LinearLayout>
    
</LinearLayout>
    <Button android:id="@+id/game_discovery_hold" style="@style/GameActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_discovery_demo_hold" android:visibility="gone" />
    <TextView android:id="@+id/game_discovery_hold_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:text="@string/game_discovery_demo_hold_hint" android:gravity="center" android:textSize="16sp" android:visibility="gone" />
    <Button android:id="@+id/game_discovery_retry" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_discovery_retry" android:visibility="gone" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/game_discovery_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:gravity="center" android:textSize="16sp" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/game_integration_discovery_continue" style="@style/GameActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_integration_continue" android:visibility="gone" />
    <Button android:id="@+id/game_discovery_exit" style="@style/GameNarrationTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_discovery_exit" android:textColor="@color/game_reskin_muted" />

</LinearLayout>
</ScrollView>
