<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/route_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#FAF7EF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CAMPUS ROUTE"
            android:textSize="12sp" android:textColor="#AB5336" android:letterSpacing="0.1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="다섯 기억을 잇는 길"
            android:layout_marginTop="12dp" android:textSize="28sp" android:textStyle="bold" android:textColor="#1E2B39" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="탐방 순서를 보여 주는 개념 안내도입니다. 실제 건물 배치나 보행 경로를 나타내지 않습니다."
            android:textColor="#636969" android:textSize="15sp" />
        <view class="com.example.firststep.RouteMapActivity$RouteView" android:layout_width="match_parent" android:layout_height="440dp"
            android:layout_marginTop="24dp" android:contentDescription="수업 건물, 도서관, 생활시설, 야외 지점, 활동 공간 순으로 이어지는 탐방" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="현장 확인 후 정식 안내도 제공\n출입구 · 안전한 보행로 · 장소 좌표를 답사하여 반영합니다. 현재 위치와 거리 안내는 좌표가 검증된 현장 미션에서만 사용할 수 있습니다."
            android:textColor="#636969" android:textSize="14sp" android:layout_marginTop="16dp" />
        <Button android:id="@+id/route_back" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="코스로 돌아가기" android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>
