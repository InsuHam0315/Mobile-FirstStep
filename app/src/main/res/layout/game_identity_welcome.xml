<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_identity_welcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_welcome_background"
    android:visibility="gone">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/game_reskin_artwork" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/game_welcome_scrim"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/game_identity_welcome_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingTop="64dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/game_welcome_panel"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/game_welcome_brand"
                    android:textColor="@color/game_reskin_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/game_identity_welcome_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityHeading="true"
                    android:gravity="start"
                    android:text="@string/app_name"
                    android:textColor="@color/game_color_text"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="start"
                    android:text="@string/game_welcome_tagline"
                    android:textColor="@color/game_color_text"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_identity_welcome_login"
                    style="@style/GameWelcomeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/game_welcome_login"
                    android:textColor="@color/game_welcome_ink"
                    app:backgroundTint="@color/game_welcome_pink" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_identity_welcome_guest"
                    style="@style/GameWelcomeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/game_welcome_guest"
                    android:textColor="@color/game_color_text"
                    app:backgroundTint="@color/game_reskin_tinted" />

                <TextView
                    android:id="@+id/game_identity_welcome_guest_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="start"
                    android:text="@string/game_welcome_guest_note"
                    android:textColor="@color/game_reskin_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
