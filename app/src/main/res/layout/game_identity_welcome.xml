<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_identity_welcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_welcome_background"
    android:visibility="gone">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/game_reskin_artwork" />

    <ScrollView
        android:id="@+id/game_identity_welcome_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="56dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/game_welcome_panel"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/game_welcome_brand"
                    android:textColor="@color/game_reskin_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/game_identity_welcome_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityHeading="true"
                    android:gravity="start"
                    android:text="@string/app_name"
                    android:textColor="@color/game_color_text"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="12dp" android:background="@color/game_reskin_line"
                    android:importantForAccessibility="no" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_identity_welcome_login"
                    style="@style/GameWelcomeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/game_welcome_login"
                    android:textColor="@color/game_color_on_action"
                    app:backgroundTint="@color/game_color_action"
                    app:iconTint="@color/game_color_on_action" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_identity_welcome_guest"
                    style="@style/GameWelcomeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="72dp"
                    android:paddingVertical="10dp"
                    android:text="@string/game_welcome_guest"
                    android:textColor="@color/game_color_text"
                    app:backgroundTint="@color/game_reskin_tinted"
                    app:iconTint="@color/game_color_text" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
