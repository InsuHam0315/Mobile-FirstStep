<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_tour_result" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/game_tour_result_back" style="@style/GameNarrationTextButton"
            android:layout_width="48dp" android:layout_height="48dp" android:padding="0dp"
            android:text="@string/game_guide_back_arrow" android:textSize="24sp"
            android:contentDescription="@string/game_software_demo_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/game_tour_result_title" android:textColor="@color/game_color_text"
            android:textSize="24sp" android:textStyle="bold" android:accessibilityHeading="true" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/game_discovery_step_idle" android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" android:text="@string/game_discovery_demo_mode"
            android:textColor="@color/game_color_text" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:background="@drawable/game_reskin_tinted_card"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="20dp">
        <ImageView android:id="@+id/game_tour_result_icon" android:layout_width="76dp" android:layout_height="76dp"
            android:importantForAccessibility="no" android:src="@drawable/game_tour_result_seal" />
        <TextView android:id="@+id/game_tour_result_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/game_color_text" android:layout_marginTop="10dp" android:gravity="center" android:textSize="23sp" android:textStyle="bold" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_discovery_demo_place" android:textColor="@color/game_color_text" android:layout_marginTop="6dp" android:gravity="center" android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:background="@drawable/game_reskin_card" android:padding="14dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="5dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_tour_result_score_label" android:textColor="@color/game_color_text" android:gravity="center" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/game_tour_result_score" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:layout_marginTop="8dp" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/game_color_action" />
</LinearLayout>
        <View android:layout_width="1dp" android:layout_height="64dp" android:background="@color/game_reskin_line" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="5dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_tour_result_stamp_label" android:textColor="@color/game_color_text" android:gravity="center" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/game_tour_result_stamp" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:layout_marginTop="8dp" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/game_color_action" />
</LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:gravity="center"
        android:layout_marginEnd="6dp" android:background="@drawable/game_discovery_step_idle"
        android:drawableStart="@drawable/game_demo_hub_check_icon" android:drawablePadding="2dp"
        android:minHeight="42dp" android:paddingHorizontal="5dp"
        android:text="@string/game_discovery_step_find" android:textColor="@color/game_color_text" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1.35" android:gravity="center"
        android:layout_marginEnd="6dp" android:background="@drawable/game_discovery_step_idle"
        android:drawableStart="@drawable/game_demo_hub_check_icon" android:drawablePadding="2dp"
        android:minHeight="42dp" android:paddingHorizontal="5dp"
        android:text="@string/game_guide_section_department" android:textColor="@color/game_color_text" android:textStyle="bold" />
        <TextView android:id="@+id/game_tour_result_quiz_step" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:gravity="center"
        android:layout_marginEnd="0dp" android:background="@drawable/game_discovery_step_idle"
        android:drawableStart="@drawable/game_demo_hub_check_icon" android:drawablePadding="2dp"
        android:minHeight="42dp" android:paddingHorizontal="5dp"
        android:text="@string/game_demo_hub_quiz" android:textColor="@color/game_color_text" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/game_tour_result_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_tour_quiz_stamp_hint" android:textColor="@color/game_color_text" android:layout_marginTop="12dp" android:gravity="center" android:textSize="14sp" android:visibility="gone" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_demo_hub_note" android:textColor="@color/game_color_text" android:layout_marginTop="16dp" android:gravity="center" android:textSize="14sp" />
    <Button android:id="@+id/game_tour_result_retry" style="@style/GameActionButton" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/game_tour_result_retry" android:layout_marginTop="14dp" android:visibility="gone" />
    <Button android:id="@+id/game_tour_result_home" style="@style/GameActionButton" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/game_software_demo_back" android:layout_marginTop="10dp" />
    <Button android:id="@+id/game_tour_result_home_secondary" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/game_software_demo_back" android:visibility="gone" />
    <Button android:id="@+id/game_tour_result_review" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/game_intro_show_again"  />
</LinearLayout>
