<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/game_intro_scroll" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/game_space_medium">
        <TextView android:id="@+id/game_intro_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_title" android:textStyle="bold" android:accessibilityHeading="true" android:textSize="@dimen/game_text_title" android:textColor="@color/game_color_text" />
        <TextView android:id="@+id/game_intro_target" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/game_text_body" android:textColor="@color/game_color_text" android:visibility="gone" />
        <TextView android:id="@+id/game_intro_disclosure" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_disclosure" android:textColor="@color/game_color_text" />
        <Button android:id="@+id/game_intro_demo" style="@style/GameActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_demo" />
        <TextView android:id="@+id/game_intro_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/game_text_body" android:textColor="@color/game_color_text" />
        <ImageView android:id="@+id/game_software_demo_intro_art" android:visibility="gone" android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="center" android:src="@drawable/game_discovery_placeholder" android:contentDescription="@string/game_narration_art" />
        <TextView android:id="@+id/game_software_demo_caption_position" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/game_text_body" android:textColor="@color/game_color_text" />
        <TextView android:id="@+id/game_intro_caption" android:background="@drawable/game_reskin_tinted_card" android:padding="@dimen/game_space_medium" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/game_text_body" android:textColor="@color/game_color_text" />
        <TextView android:id="@+id/game_software_demo_caption_origin" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/game_text_body" android:textColor="@color/game_color_text" />
        <Button android:id="@+id/game_intro_replay" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_replay" />
        <Button android:id="@+id/game_intro_next" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_next" />
        <Button android:id="@+id/game_intro_finish" style="@style/GameActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_finish" />
        <Button android:id="@+id/game_intro_skip" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_skip" />
        <Button android:id="@+id/game_intro_reminder" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_reminder" />
        <Button android:id="@+id/game_quiz_start" style="@style/GameActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_start" />
        <Button android:id="@+id/game_intro_show_again" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_show_again" />
        <LinearLayout android:id="@+id/game_quiz_questions" android:background="@drawable/game_reskin_card" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:padding="@dimen/game_space_medium" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <Button android:id="@+id/game_quiz_submit" style="@style/GameActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_submit" />
        <Button android:id="@+id/game_quiz_retry" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_retry" />
        <TextView android:id="@+id/game_quiz_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/game_text_body" android:textColor="@color/game_color_text" />
        <Button android:id="@+id/game_intro_back" style="@style/GameSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_intro_back" />
    </LinearLayout>
</ScrollView>
