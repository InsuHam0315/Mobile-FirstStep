<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/map_root"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/game_color_surface">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="국립군산대 캠퍼스 지도" android:textSize="@dimen/game_text_title" android:accessibilityHeading="true" android:textStyle="bold" android:textColor="@color/game_color_text" android:padding="16dp" />
 <TextView android:id="@+id/map_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="지도 불러오는 중 · 미션 지점은 현장 확인 후 표시합니다." android:textColor="@color/game_reskin_muted" android:paddingHorizontal="16dp" android:paddingBottom="12dp" android:textSize="14sp" />
 <TextView
     android:id="@+id/map_facility_context"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:accessibilityLiveRegion="polite"
     android:paddingHorizontal="16dp"
     android:textColor="@color/game_color_text"
     android:visibility="gone" />
 <com.example.firststep.map.CampusMapView android:id="@+id/campus_map" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" />
 <TextView android:id="@+id/map_attribution" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="© OpenStreetMap contributors · 지도 출처/이용 조건" android:textSize="12sp" android:textColor="@color/game_reskin_link" android:padding="8dp" android:minHeight="@dimen/game_touch_min" android:gravity="center" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <Button style="@style/GameMapButton" android:id="@+id/map_zoom_in" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="확대" />
  <Button style="@style/GameMapButton" android:id="@+id/map_zoom_out" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="축소" />
  <Button style="@style/GameMapButton" android:id="@+id/map_campus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="학교" />
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <Button style="@style/GameActionButton" android:id="@+id/map_location" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="내 위치" />
  <Button style="@style/GameMapButton" android:id="@+id/map_retry" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="다시 불러오기" />
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <Button style="@style/GameMapButton" android:id="@+id/map_route" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="탐방 순서도" />
  <Button
      style="@style/GameMapButton"
      android:id="@+id/map_facility_lookup"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/map_facility_lookup"
      android:visibility="gone" />
  <Button style="@style/GameMapButton" android:id="@+id/map_back" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="돌아가기" />
 </LinearLayout>
</LinearLayout>
