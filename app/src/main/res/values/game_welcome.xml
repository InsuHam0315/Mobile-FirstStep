<resources>
    <color name="game_welcome_background">#110B15</color>
    <color name="game_welcome_pink">#FFC0D0</color>
    <color name="game_welcome_ink">#2A1B29</color>
    <color name="game_welcome_muted">#F0DFE5</color>
    <color name="game_welcome_guest_fill">#302B3733</color>

    <string name="game_welcome_brand">국립군산대학교 캠퍼스 탐방</string>
    <string name="game_welcome_tagline">당신의 첫 번째 캠퍼스 탐험이 시작됩니다.</string>
    <string name="game_welcome_login">Google 계정으로 로그인</string>
    <string name="game_welcome_guest">게스트로 둘러보기</string>
    <string name="game_welcome_guest_note">학과 안내와 연습</string>
    <string name="game_welcome_guest_debug_note">학과 안내와 탐방 시연</string>
    <string name="game_welcome_footer">EXPLORE · DISCOVER · REMEMBER</string>

    <style name="GameWelcomeButton" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="icon">@drawable/game_demo_hub_arrow_icon</item>
        <item name="iconGravity">end</item>
        <item name="iconSize">20dp</item>
        <item name="cornerRadius">16dp</item>
    </style>
</resources>
