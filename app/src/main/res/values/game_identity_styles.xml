<resources>
    <style name="GameIdentityGoogleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">@font/google_sans_medium_button</item>
        <item name="fontFamily">@font/google_sans_medium_button</item>
        <item name="android:gravity">center</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/game_identity_google_text</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@android:color/white</item>
        <item name="cornerRadius">28dp</item>
        <item name="icon">@drawable/game_identity_google_g</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">0dp</item>
        <item name="iconTint">@null</item>
        <item name="strokeColor">#747775</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
