<resources>
    <color name="game_reskin_muted">#545C57</color>
    <color name="game_reskin_paper">#FFFFFF</color>
    <color name="game_reskin_tinted">#E8EFE5</color>
    <color name="game_reskin_line">#CED9CF</color>
    <color name="game_reskin_link">#435949</color>
    <color name="game_reskin_disabled_fill">#E8E4E1</color>
    <color name="game_reskin_disabled_text">#55514F</color>
    <dimen name="game_reskin_identity_hero_height">196dp</dimen>
    <dimen name="game_reskin_campus_hero_height">168dp</dimen>
    <dimen name="game_reskin_card_corner">24dp</dimen>
    <dimen name="game_reskin_control_space">8dp</dimen>

    <style name="GameSecondaryButton" parent="GameActionButton">
        <item name="backgroundTint">@color/game_reskin_secondary_tint</item>
        <item name="android:textColor">@color/game_reskin_secondary_text</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/game_reskin_line</item>
    </style>
    <style name="GameMapButton" parent="GameSecondaryButton">
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">@dimen/game_reskin_control_space</item>
        <item name="android:paddingEnd">@dimen/game_reskin_control_space</item>
    </style>
</resources>
