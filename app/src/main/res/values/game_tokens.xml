<resources>
    <style name="Theme.FirstStep.GamePreview" parent="Theme.FirstStep">
        <item name="android:windowBackground">@color/game_color_surface</item>
        <item name="android:statusBarColor">@color/game_color_surface</item>
        <item name="android:navigationBarColor">@color/game_color_surface</item>
        <item name="colorPrimary">@color/game_color_action</item>
        <item name="colorSecondary">@color/game_color_action</item>
    </style>
    <color name="game_color_surface">#FBF8F2</color>
    <color name="game_color_text">#272C2A</color>
    <color name="game_color_action">#873856</color>
    <color name="game_color_on_action">#FFFFFF</color>
    <dimen name="game_space_medium">16dp</dimen>
    <dimen name="game_space_large">24dp</dimen>
    <dimen name="game_touch_min">48dp</dimen>
    <dimen name="game_text_title">30sp</dimen>
    <dimen name="game_text_body">16sp</dimen>
    <dimen name="game_shape_action_corner">16dp</dimen>
    <style name="GameActionButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/game_shape_action_corner</item>
        <item name="android:textSize">@dimen/game_text_body</item>
        <item name="backgroundTint">@color/game_reskin_primary_tint</item>
        <item name="android:textColor">@color/game_reskin_primary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">@dimen/game_touch_min</item>
    </style>
</resources>
